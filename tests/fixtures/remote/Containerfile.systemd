FROM docker.io/library/debian:12
ENV container=podman
RUN apt-get update && apt-get install -y --no-install-recommends systemd systemd-sysv dbus openssh-server procps iproute2 \
 && rm -rf /var/lib/apt/lists/* && useradd -m -s /bin/bash tester && sed -i 's/^tester:!/tester:*/' /etc/shadow \
 && systemctl enable ssh
STOPSIGNAL SIGRTMIN+3
CMD ["/sbin/init"]
